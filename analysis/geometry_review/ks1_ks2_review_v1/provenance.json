      "junction_jump_diagnostic_deg": 15.0,
      "substitution_convergence_tol": 0.0001
    },
    "decisions": {
      "ks1": [
        {
          "id": "K1_KEEP",
          "when": "resolved shape effect (S_shape >= keep_shape or S_local >= keep_local, signal_to_noise >= noise_multiplier) in >= keep_min_backgrounds AND (max cosine_raw < cosine_independence OR max residual_fraction > residual_independence) AND substitution residual_fraction > substitution_max_residual in >= keep_min_backgrounds",
          "decision": "KEEP_RECOMMENDED",
          "reason": "stable independent geometry effect that a single Xmean value cannot reproduce"
        },
        {
          "id": "K1_FIX",
          "when": "S_shape < review_shape AND S_local < review_local in >= 6/7 backgrounds AND signal_to_noise < noise_multiplier in >= 5/7 backgrounds, OR substitution residual_fraction <= substitution_max_residual in >= 6/7 backgrounds with cosine_raw >= cosine_high in >= 6/7",
          "decision": "FIX_RECOMMENDED",
          "reason": "no resolved independent effect, or a single Xmean value reproduces the contour"
        },
        {
          "id": "K1_REVIEW",
          "when": "none of the above",
          "decision": "FURTHER_REVIEW",
          "reason": "background-dependent, near threshold, or substitution evidence is mixed"
        }
      ],
      "ks2": [
        {
          "id": "K2_KEEP",
          "when": "resolved rear-local effect (S_rear >= keep_rear, signal_to_noise >= noise_multiplier) in >= keep_min_backgrounds AND (cosine with K_m and Metal2 < cosine_independence OR residual_fraction > residual_independence) AND substitution by K_m/Metal2 residual_fraction > substitution_max_residual in >= keep_min_backgrounds",
          "decision": "KEEP_RECOMMENDED",
          "reason": "stable rear-local control not reproduced by K_m or Metal2"
        },
        {
          "id": "K2_FIX",
          "when": "S_rear < review_rear AND S_shape < review_shape in >= 6/7 backgrounds AND (signal_to_noise < noise_multiplier in >= 5/7 OR substitution residual_fraction <= substitution_max_residual in >= 6/7)",
          "decision": "FIX_RECOMMENDED",
          "reason": "rear-local effect is below resolution or fully reproducible by K_m/Metal2"
        },
        {
          "id": "K2_REVIEW",
          "when": "none of the above",
          "decision": "FURTHER_REVIEW",
          "reason": "effect appears only in specific backgrounds, or evidence is contradictory"
        }
      ],
      "notes": [
        "a high cosine alone NEVER triggers FIX; the residual and substitution evidence are mandatory",
        "a low global S_comp alone NEVER triggers FIX for Ks2; the rear-local and noise checks are mandatory",
        "SS1/SS2 are FIXED_BY_REVIEW and are not re-classified here",
        "all decisions are advisory; they do not change any formal parameter state"
      ]
    }
  },
