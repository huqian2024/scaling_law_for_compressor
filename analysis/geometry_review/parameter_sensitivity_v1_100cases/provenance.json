      "min_levels_for_fix": 3,
      "min_backgrounds_for_fix": 2,
      "min_background_effect_low_comp": 0.002,
      "min_background_effect_low_local": 0.01,
      "negligible_change_floor": 0.0002
    },
    "weights": {
      "S_contour": 0.3,
      "S_camber": 0.2,
      "S_le": 0.15,
      "S_te": 0.15,
      "S_thickness": 0.15,
      "S_cascade": 0.05
    },
    "classification_rules": [
      {
        "id": "R0_SOLIDITY",
        "when": "parameter == 'Solidity'",
        "decision": "KEEP_CANDIDATE if S_cascade >= keep_cascade and qc_pass_rate >= qc_pass_rate_min; REVIEW if S_cascade >= review_cascade; FIX_CANDIDATE only if S_cascade < review_cascade in >=2 backgrounds",
        "rationale": "Solidity never changes single-blade coordinates; it must be judged by cascade metrics only"
      },
      {
        "id": "R1_KEEP_HIGH",
        "when": "S_comp >= keep_comp or S_le >= keep_local or S_te >= keep_local",
        "decision": "KEEP_CANDIDATE if qc_pass_rate >= qc_pass_rate_min, else REVIEW with boundary warning"
      },
      {
        "id": "R3_FIX_LOW",
        "when": "S_comp < review_comp AND S_le < review_local AND S_te < review_local AND S_cascade < review_cascade AND n_levels >= min_levels_for_fix AND no_failure_attributable AND low_in_backgrounds >= min_backgrounds_for_fix",
        "decision": "FIX_CANDIDATE"
      },
      {
        "id": "R4_FIX_REDUNDANT",
        "when": "redundancy_cos >= redundancy_cosine AND redundancy_ratio <= redundancy_ratio AND S_comp < keep_comp AND n_levels >= min_levels_for_fix AND no_failure_attributable AND low_in_backgrounds >= min_backgrounds_for_fix",
        "decision": "FIX_CANDIDATE"
      },
      {
        "id": "R2_REVIEW_MEDIUM",
        "when": "S_comp >= review_comp or S_le >= review_local or S_te >= review_local or S_cascade >= review_cascade",
        "decision": "REVIEW"
      },
      {
        "id": "R5_REVIEW_INSUFFICIENT",
        "when": "none of the above",
        "decision": "REVIEW (insufficient evidence for KEEP or FIX)"
      }
    ]
  },
